{
  "entities": {
    "Profile": {
      "title": "Artist Profile",
      "description": "User's artistic profile and identity",
      "type": "object",
      "properties": {
        "stageName": { "type": "string" },
        "realName": { "type": "string" },
        "discipline": { "type": "string" },
        "disciplineColor": { "type": "string" },
        "style": { "type": "string" },
        "styleColor": { "type": "string" },
        "loves": { "type": "string" },
        "inspirations": { "type": "string" },
        "obsessions": { "type": "string" },
        "profileImage": { "type": "string" },
        "upcomingProjects": { "type": "array", "items": { "type": "string" } },
        "deadlines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "date": { "type": "string" }
            }
          }
        },
        "isOnboarded": { "type": "boolean" },
        "tickets": {
          "type": "object",
          "properties": {
            "remaining": { "type": "number" },
            "totalUsed": { "type": "number" },
            "lastResetDate": { "type": "string" }
          }
        }
      }
    },
    "Project": {
      "title": "Project",
      "description": "A creative project in the workshop",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Exploring", "Stalled", "Paused", "Complete"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "is_archived": { "type": "boolean" },
        "total_minutes": { "type": "number" },
        "tools_and_materials": { "type": "array", "items": { "type": "string" } },
        "technical_notes": { "type": "array", "items": { "type": "string" } },
        "milestones": { "type": "array", "items": { "type": "string" } },
        "accumulated_insights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "date": { "type": "string" },
              "type": { "type": "string", "enum": ["technical", "conceptual", "aesthetic"] }
            }
          }
        },
        "unresolved_hurdles": { "type": "array", "items": { "type": "string" } },
        "mood_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string" },
              "level": { "type": "number" }
            }
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "startDate": { "type": "string" },
              "endDate": { "type": "string" },
              "is_complete": { "type": "boolean" }
            }
          }
        },
        "color": { "type": "string" },
        "is_locked": { "type": "boolean" }
      }
    },
    "Session": {
      "title": "Workshop Session",
      "description": "Records of completed creative sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["session", "idea", "brainstorm", "problem", "post"] },
        "project_id": { "type": "string" },
        "project_name": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "duration_minutes": { "type": "number" },
        "actual_duration_minutes": { "type": "number" },
        "stage": { "type": "string" },
        "summary": { "type": "string" },
        "how_it_went": { "type": "string" },
        "materials_used": { "type": "array", "items": { "type": "string" } },
        "raw_transcript": { "type": "string" },
        "audio_recording_id": { "type": "string" }
      }
    },
    "Recording": {
      "title": "Voice Recording",
      "description": "Audio recordings and voice memos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "audio_base64": { "type": "string" },
        "duration_seconds": { "type": "number" },
        "transcript": { "type": "string" },
        "related_project_id": { "type": "string" },
        "related_session_id": { "type": "string" }
      }
    },
    "CalendarEvent": {
      "title": "Calendar Event",
      "description": "Commitments and events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["deadline", "session", "event", "milestone"] },
        "project_id": { "type": "string" },
        "reminder_set": { "type": "boolean" },
        "reminder_config": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "advance_value": { "type": "string" },
            "specific_date": { "type": "string" },
            "specific_time": { "type": "string" }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "ProtocolLog": {
      "title": "Protocol Log",
      "description": "Logs of applied block-breaking strategies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "strategyId": { "type": "string" },
        "strategyName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "duration": { "type": "number" },
        "reflection": { "type": "string" },
        "reflectionType": { "type": "string", "enum": ["voice", "text"] }
      }
    },
    "EnergyCheckIn": {
      "title": "Energy Check-In",
      "description": "Studio vital updates and energy levels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "level": { "type": "number" },
        "note": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}/profiles/main": {
      "schema": "Profile",
      "description": "User profile data"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Creative projects"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Timed session logs"
    },
    "/users/{userId}/recordings/{recordingId}": {
      "schema": "Recording",
      "description": "Voice recordings"
    },
    "/users/{userId}/calendarEvents/{eventId}": {
      "schema": "CalendarEvent",
      "description": "Commitments and calendar items"
    },
    "/users/{userId}/protocolLogs/{logId}": {
      "schema": "ProtocolLog",
      "description": "Applied protocol records"
    },
    "/users/{userId}/energyHistory/{checkInId}": {
      "schema": "EnergyCheckIn",
      "description": "Studio vital logs"
    }
  }
}
